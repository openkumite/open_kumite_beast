<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>OpenKumiteBeast: third-party licenses</title>
<style>
body { font: 15px/1.5 system-ui, sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; color: #222; background: #fff; }
pre { white-space: pre-wrap; background: #f4f4f4; padding: 1rem; font-size: 13px; }
li { margin: 0.1rem 0; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>OpenKumiteBeast is distributed under the MIT License (see LICENSE). It includes the following third-party software,
each under its own license.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>License texts</h2>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
